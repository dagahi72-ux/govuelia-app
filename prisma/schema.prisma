generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Alerta {
  id        String   @id @default(cuid())
  origen    String
  destino   String
  fecha     String
  precioObjetivo Float
  email     String
  createdAt DateTime @default(now())
}